    "cues": [
      { "from": 8,    "to": 92,   "text": "Keling, bu savolni birga ko‘rib chiqamiz." },
      { "from": 112,  "to": 205,  "text": "Tartibga soluvchining ikkala qo‘li yon tomonga uzatilgan." },
      { "from": 210,  "to": 296,  "text": "Yon tomonlardan to‘g‘riga va o‘ngga yurish mumkin." },
      { "from": 300,  "to": 392,  "text": "Old va orqa tomonidan esa harakatlanish taqiqlanadi." },
      { "from": 402,  "to": 476,  "text": "Oq avtomobil old tomonda — u to‘xtaydi." },
      { "from": 482,  "to": 560,  "text": "Yashil avtomobil orqa tomonda — u ham to‘xtaydi." },
      { "from": 566,  "to": 655,  "text": "Ko‘k yon tomonda, lekin chapga burilish ishorasini yoqqan." },
      { "from": 660,  "to": 736,  "text": "Chapga burilish taqiqlangan — u ham kutadi." },
      { "from": 742,  "to": 836,  "text": "Qizil va sariq esa to‘g‘riga yoki o‘ngga yura oladi." },
      { "from": 848,  "to": 952,  "text": "Ikki javobda yura oladigan avtomobil bor — ular xato." },
      { "from": 962,  "to": 1050, "text": "To‘g‘ri javob: ko‘k, yashil va oq avtomobillarga." }
    ]
